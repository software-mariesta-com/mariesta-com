# Drizzle
# Replace with your DB credentials!
DATABASE_URL="postgres://user:password@host:port/db-name"

# This app's public origin (IdP)
# Local: http://localhost:5173
# Production: https://mariesta.com
ORIGIN="http://localhost:5173"

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
# Must match Menzies BETTER_AUTH_SECRET when sharing the auth database / session.
BETTER_AUTH_SECRET=""

# Non-destructive secret rotation (Better Auth 1.6+). Optional.
# Format: version:secret pairs, comma-separated. First entry encrypts new data; later entries decrypt old data.
# When rotating, keep the PREVIOUS secret here (and in BETTER_AUTH_SECRET as legacy fallback for bare-hex rows).
# Example after one rotation (new secret is version 2, old is version 1):
# BETTER_AUTH_SECRETS="2:<new-secret>,1:<old-secret>"
# BETTER_AUTH_SECRET="<old-secret>"
# All apps sharing the auth DB (Menzies, Ribbonize) must use the same BETTER_AUTH_SECRET / BETTER_AUTH_SECRETS.
# Changing BETTER_AUTH_SECRET alone invalidates encrypted 2FA TOTP secrets and backup codes until you revert,
# configure versioned secrets, or users re-enroll 2FA.
# BETTER_AUTH_SECRETS=""

# SSO: comma-separated trusted website origins (Menzies, Ribbonize, other RPs).
# Used for Better Auth trustedOrigins and redirectTo allowlist validation.
# Local: Menzies 5174, Ribbonize 5175
# Prod example: https://menzies.mariesta.com,https://ribbonize.mariesta.com
SSO_TRUSTED_ORIGINS="http://localhost:5174,http://localhost:5175"
# Alias accepted if SSO_TRUSTED_ORIGINS is unset:
# TRUSTED_ORIGINS="https://menzies.mariesta.com,https://ribbonize.mariesta.com,http://localhost:5174,http://localhost:5175"

# Optional session cookie Domain for sibling SSO (prod). Leave empty on localhost.
# Example: .mariesta.com  (so mariesta.com + menzies.mariesta.com share the cookie)
AUTH_COOKIE_DOMAIN=""

# Better Auth session lifetime (defaults: 2h max, 1h sliding refresh).
# Durations: `2h`, `30m`, or plain seconds (e.g. `7200`).
# Match Menzies when sharing the auth database / session.
# AUTH_SESSION_EXPIRES_IN="2h"
# AUTH_SESSION_UPDATE_AGE="1h"
# AUTH_SESSION_COOKIE_CACHE_ENABLED="false"
# AUTH_SESSION_COOKIE_CACHE_MAX_AGE="30m"
# AUTH_SESSION_SECURE_COOKIES="true"

# HMAC secret for one-time SSO code handoff when cookies cannot be shared (localhost).
# Rotate anytime via env. Must match Menzies. Falls back to a derivation of BETTER_AUTH_SECRET.
SSO_HMAC_SECRET=""

# Optional GitHub OAuth
# Callback URL: {ORIGIN}/api/auth/callback/github
# https://www.better-auth.com/docs/authentication/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Gmail SMTP for OTP + password-reset emails
# Create an App Password: https://myaccount.google.com/apppasswords
# (Google Account → Security → 2-Step Verification → App passwords)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your.name@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM="your.name@gmail.com"

# Tigris (S3-compatible) object storage for partner logos and member photos
# Create a bucket via `fly storage create` or the Tigris console, then fill these in.
# Prefer a bucket name without dots (e.g. mariesta-org). Dotted names break Tigris public CDN SSL.
# Images are served via /api/media/... so private buckets work fine.
# Use TIGRIS_* names (not AWS_*): Netlify reserves AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION.
TIGRIS_ACCESS_KEY_ID=""
TIGRIS_SECRET_ACCESS_KEY=""
TIGRIS_ENDPOINT_URL="https://t3.storage.dev"
TIGRIS_REGION="auto"
TIGRIS_BUCKET_NAME=""

# Profile: link for "Change tier" (pricing page, Stripe portal, etc.)
# Defaults to {ORIGIN}/home when unset.
# TIER_CHANGE_URL="https://mariesta.com/pricing"

# Profile: link for "Browse plan" (Menzies software store, etc.)
# Defaults to the first SSO_TRUSTED_ORIGINS entry when unset.
# BROWSE_PLANS_URL="http://localhost:5174"
